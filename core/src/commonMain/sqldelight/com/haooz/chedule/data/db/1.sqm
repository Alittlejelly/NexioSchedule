-- 1 → 2：把还留在 prefs 里的三块业务数据搬进表。
--
-- 只加列/加表，不改既有列：Android 1.6.7 用户的库是 v1，ALTER 是唯一安全动作。
-- 默认值必须与读取口的兜底一致，否则升级后「没设过」的课表会拿到另一个值：
--   smart_weekend         默认 false（getSmartWeekend 的默认）
--   show_non_current_week 默认 true （getShowNonCurrentWeek 的默认）

ALTER TABLE schedule ADD COLUMN smart_weekend INTEGER NOT NULL DEFAULT 0;
ALTER TABLE schedule ADD COLUMN show_non_current_week INTEGER NOT NULL DEFAULT 1;

ALTER TABLE folder ADD COLUMN payload TEXT NOT NULL DEFAULT '[]';

CREATE TABLE teaching_week_reorganizations (
    schedule_id TEXT NOT NULL PRIMARY KEY REFERENCES schedule(id) ON DELETE CASCADE,
    payload     TEXT NOT NULL
);
