                            android:layout_marginBottom="6dp"
                            android:scaleType="fitXY"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            tools:ignore="NestedWeights,RtlSymmetry">

                            <TextView
                                android:id="@+id/widget_name8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14dp"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/widget_name_color"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/widget_course_time8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/widget_time_start_color"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_info8"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/widget_time_end_color"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Course card 10 -->
                    <LinearLayout
                        android:id="@+id/widget_course10"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/widget_card_background_jinming"
                        android:paddingStart="8dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginBottom="7dp"
                        android:clipChildren="true"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/widget_color10"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="6dp"
                            android:scaleType="fitXY"
                            tools:ignore="ContentDescription" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            tools:ignore="NestedWeights,RtlSymmetry">

                            <TextView
                                android:id="@+id/widget_name10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14dp"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/widget_name_color"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/widget_course_time10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="@color/widget_time_start_color"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/widget_info10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="12dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/widget_time_end_color"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 整列无课：覆盖整列、上下居中（与另一列卡片区的垂直中心对齐） -->
                <TextView
                    android:id="@+id/widget_empty_tomorrow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingBottom="7dp"
                    android:textSize="13dp"
                    android:textColor="@color/widget_empty_color"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
